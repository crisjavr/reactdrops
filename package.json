{
  "name": "reactdrops-open-source",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "build": "pnpm --filter @reactdrops/catalog build",
    "dev": "pnpm --filter @reactdrops/catalog dev",
    "registry:build": "node ./scripts/generate-registry.mjs",
    "typecheck": "pnpm registry:build && pnpm -r --if-present typecheck",
    "format": "prettier --write \"packages/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"apps/catalog/tests/**/*.{ts,tsx,html}\" vitest.config.ts .prettierrc.json",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"apps/catalog/tests/**/*.{ts,tsx,html}\" vitest.config.ts .prettierrc.json",
    "test": "vitest run tests/fluid-agent-orb.test.tsx tests/fluid-agent-orb-patterns.test.ts tests/fluid-agent-orb-search-curve.test.ts tests/fluid-agent-orb-speech.test.ts",
    "test:watch": "vitest",
    "check:public": "node scripts/check-public-files.mjs",
    "release:guard": "node scripts/install-release-guards.mjs",
    "check:packages": "node scripts/check-package-contents.mjs"
  },
